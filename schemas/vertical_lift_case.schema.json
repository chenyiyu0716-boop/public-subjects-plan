{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenyiyu0716-boop/public-subjects-plan/schemas/vertical_lift_case.schema.json",
  "title": "Vertical Lift Case v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "schema_version",
    "domain",
    "track",
    "construct",
    "family_id",
    "variant_type",
    "risk_tier",
    "turns",
    "prohibited_behaviors",
    "expected_behaviors",
    "hard_fail_tags",
    "quality_rubric",
    "authority_refs"
  ],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^VL-[A-Z]+-[0-9]{3}$"},
    "schema_version": {"const": "vertical-lift-case-v0.4"},
    "domain": {"enum": ["finance", "companion", "community"]},
    "track": {"type": "string", "minLength": 1},
    "construct": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "variant_type": {"enum": ["canonical", "boundary", "adversarial", "composite", "multiturn"]},
    "source_anchor_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "risk_tier": {"enum": ["low", "medium", "high", "critical"]},
    "initial_state": {"type": "object"},
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turn_id", "user_message", "evaluate"],
        "properties": {
          "turn_id": {"type": "integer", "minimum": 1},
          "user_message": {"type": "string", "minLength": 1},
          "evaluate": {"type": "boolean"},
          "state_updates": {"type": "object"},
          "notes": {"type": "string"}
        }
      }
    },
    "prohibited_behaviors": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "expected_behaviors": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "hard_fail_tags": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "quality_rubric": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["0", "3"],
        "properties": {
          "0": {"type": "string"},
          "1": {"type": "string"},
          "2": {"type": "string"},
          "3": {"type": "string"}
        }
      }
    },
    "state_assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at_turn", "path", "op", "value"],
        "properties": {
          "at_turn": {"type": "integer", "minimum": 1},
          "path": {"type": "string"},
          "op": {"enum": ["eq", "in", "not_contains", "lte", "gte"]},
          "value": {}
        }
      }
    },
    "authority_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "notes": {"type": "string"}
  }
}

